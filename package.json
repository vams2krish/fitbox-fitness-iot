    "vendor:model": "node tools/vendor-model.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@mediapipe/tasks-vision": "1.2.3",
    "@neondatabase/serverless": "1.2.1",
    "better-auth": "1.7.25",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "stripe": "23.1.0",
    "three": "0.187.0"
  }
